DJANGO_API_URL=http://localhost:8000/api
SESSION_SECRET=change-me-to-a-random-string-of-32+-chars
# How many reverse proxies sit in front of this app and append the visitor's address to X-Forwarded-For (0: none, the address is unknown and the
# backend then sees this server for everyone). The address is passed to the backend as its only X-Forwarded-For entry; the backend's
# THROTTLE_NUM_PROXIES must be 1 and this app must reach it directly (private address), not through the public proxy.
TRUSTED_PROXY_HOPS=1   # 0 (the default when unset) believes no X-Forwarded-For header
